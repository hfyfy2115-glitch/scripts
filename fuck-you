local function createDisc(color, material, radius, modelName, tag, height)
    local p = Instance.new("Part")
    p.Name = tag .. "_" .. modelName
    p.Color = color
    p.Material = material
    p.Transparency = 1
    p.Anchored = true
    p.CanCollide = false
    p.CanTouch = false
    p.CanQuery = false
    p.CastShadow = false
    p.Shape = Enum.PartType.Cylinder
    
    if height and height > 1 then
        p.Size = Vector3.new(height, radius * 2, radius * 2) -- Столб (X - высота)
    else
        p.Size = Vector3.new(0.2, radius * 2, radius * 2) -- Блин (X - толщина)
    end
    p.Parent = folder
    return p
end

local function createSphere(color, material, radius, modelName, tag)
    local p = Instance.new("Part")
    p.Name = tag .. "_" .. modelName
    p.Color = color
    p.Material = material
    p.Transparency = 1
    p.Anchored = true
    p.CanCollide = false
    p.CanTouch = false
    p.CanQuery = false
    p.CastShadow = false
    p.Shape = Enum.PartType.Ball
    p.Size = Vector3.new(radius * 2, radius * 2, radius * 2)
    p.Parent = folder
    return p
end

local function createVisualsFor(model, stats)
    local v, s, h
    if Settings.Sphere then
        v = createSphere(Color3.fromRGB(0, 150, 255), Enum.Material.SmoothPlastic, stats.vision, model.Name, "Vision")
        s = createSphere(Color3.fromRGB(255, 100, 0), Enum.Material.SmoothPlastic, stats.instant, model.Name, "Sight")
        h = createSphere(Color3.fromRGB(255, 0, 0), Enum.Material.Neon, stats.kill, model.Name, "Hit")
    else
        local vHeight = (model.Name == "SquirmMonster" or model.Name == "TwistedSquirm" or model.Name == "Squirm") and TALL_CYLINDER_HEIGHT or 0.2
        v = createDisc(Color3.fromRGB(0, 150, 255), Enum.Material.SmoothPlastic, stats.vision, model.Name, "Vision", vHeight)
        s = createDisc(Color3.fromRGB(255, 100, 0), Enum.Material.SmoothPlastic, stats.instant, model.Name, "Sight", 0.2)
        h = createDisc(Color3.fromRGB(255, 0, 0), Enum.Material.Neon, stats.kill, model.Name, "Hit", 0.2)
    end
    return {
        vision = v,
        sight = s,
        hit = h,
        stats = stats
    }
end

local function destroyVisualsFor(vis)
    if not vis then return end
    if vis.vision then vis.vision:Destroy() end
    if vis.sight then vis.sight:Destroy() end
    if vis.hit then vis.hit:Destroy() end
end

local function fullScan()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and not activeVisuals[obj] then
            local stats = monsterStats[obj.Name]
            if stats then
                activeVisuals[obj] = createVisualsFor(obj, stats)
            end
        end
    end
    for model, vis in pairs(activeVisuals) do
        if not model.Parent then
            destroyVisualsFor(vis)
            activeVisuals[model] = nil
        end
    end
end


local dataFolder = ReplicatedStorage:FindFirstChild("MonsterData")
if dataFolder then
    for _, module in ipairs(dataFolder:GetChildren()) do
        if module:IsA("ModuleScript") then
            local success, data = pcall(require, module)
            if success and type(data) == "table" then
                local name = module.Name
                
                if name == "GourdyMonster" then
                    monsterStats[name] = {
                        vision = 100,
                        instant = 35,
                        kill = 4
                    }
                elseif name == "SquirmMonster" or name == "TwistedSquirm" or name == "Squirm" then
                    monsterStats[name] = {
                        vision = 14,
                        instant = 14,
                        kill = 4
                    }
                else
                    local bonus = NO_BONUS_MONSTERS[name] and 0 or RADIUS_BONUS
                    monsterStats[name] = {
                        vision = (data.VisionRadius or 55) + bonus,
                        instant = (data.InstantRadius or 26) + bonus,
                        kill = (data.KillRadius or 3.33) + bonus
                    }
                end
            end
        end
    end
end


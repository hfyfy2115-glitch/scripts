local scanThread = task.spawn(function()
    while getgenv().ShowTwistedRadii do
        task.wait(FALLBACK_SCAN_INTERVAL)
        if not folder or not folder.Parent then
            folder = Instance.new("Folder")
            folder.Name = "TwistedRadius"
            folder.Parent = workspace
            for _, vis in pairs(activeVisuals) do
                destroyVisualsFor(vis)
            end
            activeVisuals = {}
        end
        fullScan()
    end
end)

getgenv().XP_RadiiCleanup = function()
    getgenv().ShowTwistedRadii = false
    if heartbeatConn then heartbeatConn:Disconnect() end
    if descendantAddedConn then descendantAddedConn:Disconnect() end
    if descendantRemovedConn then descendantRemovedConn:Disconnect() end
    if scanThread then pcall(function() task.cancel(scanThread) end) end
    for _, vis in pairs(activeVisuals) do
        destroyVisualsFor(vis)
    end
    for _, disc in pairs(handVisuals) do
        if disc and disc.Parent then disc:Destroy() end
    end
    activeVisuals = {}
    handVisuals = {}
    local f = workspace:FindFirstChild("TwistedRadius")
    if f then f:Destroy() end
    if screen then screen:Destroy() end
end


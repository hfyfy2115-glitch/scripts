local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local heartbeatConn
heartbeatConn = RunService.Heartbeat:Connect(function()
    if not getgenv().ShowTwistedRadii then return end
    local sphereMode = Settings.Sphere
    local tr = Settings.Transparency
    local vTr = Settings.Vision and tr or 1
    local sTr = Settings.Sight and tr or 1
    local hTr = Settings.Hit and tr or 1

    local myChar = player.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local targetHeight = myHRP and myHRP.Position.Y or nil

    for model, vis in pairs(activeVisuals) do
        if model.Parent then
            local hrp = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
            if hrp then
                local center = hrp.Position

                local exclude = {folder, model}
                if player.Character then table.insert(exclude, player.Character) end
                rayParams.FilterDescendantsInstances = exclude
                local hit = workspace:Raycast(center, Vector3.new(0, -15, 0), rayParams)
                local groundY = hit and (hit.Position.Y + 0.15) or (center.Y - 2.9)

                if sphereMode then
                    vis.vision.CFrame = CFrame.new(center)
                    if vis.vision.Transparency ~= vTr then vis.vision.Transparency = vTr end
                    
                    vis.sight.CFrame = CFrame.new(center)
                    if vis.sight.Transparency ~= sTr then vis.sight.Transparency = sTr end
                    
                    vis.hit.CFrame = CFrame.new(center)
                    if vis.hit.Transparency ~= hTr then vis.hit.Transparency = hTr end
                else
                    local isSquirm = (model.Name == "SquirmMonster" or model.Name == "TwistedSquirm" or model.Name == "Squirm")
                    
                    if isSquirm then
                        local h = TALL_CYLINDER_HEIGHT
                        local centerY = groundY + (h / 2)
                        vis.vision.Size = Vector3.new(h, vis.stats.vision * 2, vis.stats.vision * 2)
                        vis.vision.CFrame = CFrame.new(Vector3.new(center.X, centerY, center.Z)) * CFrame.Angles(0, 0, math.rad(90))
                    else
                        vis.vision.Size = Vector3.new(0.2, vis.stats.vision * 2, vis.stats.vision * 2)
                        vis.vision.CFrame = CFrame.new(Vector3.new(center.X, groundY, center.Z)) * CFrame.Angles(0, 0, math.rad(90))
                    end
                    
                    if vis.vision.Transparency ~= vTr then vis.vision.Transparency = vTr end

                    vis.sight.Size = Vector3.new(0.2, vis.stats.instant * 2, vis.stats.instant * 2)
                    vis.sight.CFrame = CFrame.new(Vector3.new(center.X, groundY, center.Z)) * CFrame.Angles(0, 0, math.rad(90))
                    if vis.sight.Transparency ~= sTr then vis.sight.Transparency = sTr end
                    
                    vis.hit.Size = Vector3.new(0.2, vis.stats.kill * 2, vis.stats.kill * 2)
                    vis.hit.CFrame = CFrame.new(Vector3.new(center.X, groundY, center.Z)) * CFrame.Angles(0, 0, math.rad(90))
                    if vis.hit.Transparency ~= hTr then vis.hit.Transparency = hTr end
                end
            end
        end
    end

    local handsFound = {}
    local currentRoom = workspace:FindFirstChild("CurrentRoom")
    
    if currentRoom then
        for _, obj in ipairs(currentRoom:GetDescendants()) do
            if obj.Name == "BlotHand_R" or obj.Name == "BlotHand_L" then
                local triggerZone = obj:FindFirstChild("TriggerZone", true)
                
                if triggerZone and triggerZone:IsA("BasePart") then
                    handsFound[triggerZone] = true
                    
                    local disc = handVisuals[triggerZone]
                    if not disc or not disc.Parent then
                        disc = createDisc(Color3.fromRGB(0, 150, 255), Enum.Material.SmoothPlastic, 13, obj.Name, "Hand_Vision")
                        handVisuals[triggerZone] = disc
                    end
                    
                    local handPos = triggerZone.Position
                    local exclude = {folder, triggerZone}
                    if player.Character then table.insert(exclude, player.Character) end
                    rayParams.FilterDescendantsInstances = exclude
                    
                    local hHit = workspace:Raycast(handPos, Vector3.new(0, -15, 0), rayParams)
                    local handGroundY = hHit and (hHit.Position.Y + 0.15) or (handPos.Y - 2.9)
                    
                    if sphereMode then
                        disc.CFrame = CFrame.new(handPos)
                        disc.Size = Vector3.new(26, 26, 26)
                    else
                        local h = TALL_CYLINDER_HEIGHT
                        local centerY = handGroundY + (h / 2)
                        disc.Size = Vector3.new(h, 26, 26)
                        disc.CFrame = CFrame.new(Vector3.new(handPos.X, centerY, handPos.Z)) * CFrame.Angles(0, 0, math.rad(90))
                    end
                    if disc.Transparency ~= vTr then disc.Transparency = vTr end
                end
            end
        end
    end

    for part, disc in pairs(handVisuals) do
        if not handsFound[part] or not part.Parent then
            if disc and disc.Parent then disc:Destroy() end
            handVisuals[part] = nil
        end
    end
end)


-- [FIX] на тач-устройствах RenderStepped не трогает мышь, чтобы не конфликтовать с тач-обработчиком
RunService.RenderStepped:Connect(function()
    if isTouchDevice then return end
    if not isCameraCentered or not isRunning then
        lastMousePos = UserInputService:GetMouseLocation()
        return
    end
    if not isRMBHeld then
        lastMousePos = UserInputService:GetMouseLocation()
        return
    end
    local mouseLocation = UserInputService:GetMouseLocation()
    if lastMousePos then
        local dx = mouseLocation.X - lastMousePos.X
        local dy = mouseLocation.Y - lastMousePos.Y
        if dx ~= 0 or dy ~= 0 then
            cameraRotX = cameraRotX - dx * 0.4
            cameraRotY = math.clamp(cameraRotY - dy * 0.4, -75, 75)
        end
    end
    lastMousePos = mouseLocation
end)

UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        isRMBHeld = true
        lastMousePos = UserInputService:GetMouseLocation()
    elseif input.UserInputType == Enum.UserInputType.Touch and isCameraCentered and isRunning then
        -- [FIX] фиксируем только первый палец, остальные игнорируем
        if not lastTouchPos then
            lastTouchPos = input.Position
        end
    end
end)

UserInputService.InputChanged:Connect(function(input, processed)
    if not isCameraCentered or not isRunning or processed then return end
    if input.UserInputType == Enum.UserInputType.Touch then
        if not lastTouchPos then
            lastTouchPos = input.Position
            return
        end
        local dx = input.Position.X - lastTouchPos.X
        local dy = input.Position.Y - lastTouchPos.Y
        -- [FIX] защита от скачка при мультитаче / смене пальца
        if math.abs(dx) > 60 or math.abs(dy) > 60 then
            lastTouchPos = input.Position
            return
        end
        -- [FIX] сглаживание, чтобы не было резких рывков камеры
        local smooth = 0.35
        dx = dx * smooth
        dy = dy * smooth
        cameraRotX = cameraRotX - dx * 0.4
        cameraRotY = math.clamp(cameraRotY - dy * 0.4, -75, 75)
        lastTouchPos = input.Position
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        isRMBHeld = false
        lastMousePos = nil
    elseif input.UserInputType == Enum.UserInputType.Touch then
        lastTouchPos = nil
    end
end)


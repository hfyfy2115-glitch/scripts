local function refreshBodyCache()
    local char = player.Character
    if not char then bodyPartsCache = nil return end
    bodyPartsCache = {}
    for _, partName in ipairs({"Head", "LeftArm", "LeftLeg", "RightArm", "RightLeg", "Torso"}) do
        local part = char:FindFirstChild(partName)
        if part then table.insert(bodyPartsCache, part) end
    end
end

local lastTransparency = nil
local function setBodyTransparency(value)
    if lastTransparency == value then return end
    lastTransparency = value
    if not bodyPartsCache then refreshBodyCache() end
    if bodyPartsCache then
        for _, part in ipairs(bodyPartsCache) do
            part.Transparency = value
        end
    end
end

player.CharacterAdded:Connect(function()
    bodyPartsCache = nil
    lastTransparency = nil
    task.wait(1)
    refreshBodyCache()
end)

local function createCenterBlock()
    if centerBlock then centerBlock:Destroy() end
    centerBlock = Instance.new("Part")
    centerBlock.Name = "CircleCenter"
    centerBlock.Size = Vector3.new(1, 1, 1)
    centerBlock.Transparency = 1
    centerBlock.CanCollide = false
    centerBlock.Anchored = true
    centerBlock.Parent = workspace
    if currentCenter then centerBlock.Position = currentCenter end
end

local function createPlatform()
    if platform then platform:Destroy() end
    platform = Instance.new("Part")
    platform.Name = "CirclePlatform"
    platform.Size = Vector3.new(PLATFORM_SIZE, 1, PLATFORM_SIZE)
    platform.Transparency = 0.5
    platform.CanCollide = true
    platform.Anchored = true
    platform.Parent = workspace
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if root then
        platform.Position = Vector3.new(root.Position.X, root.Position.Y - FOOT_OFFSET, root.Position.Z)
    elseif currentCenter then
        platform.Position = Vector3.new(currentCenter.X, currentCenter.Y - FOOT_OFFSET, currentCenter.Z)
    end
end

local function createVisualClone()
    if visualClone then visualClone:Destroy() end
    if not player.Character then return end
    pcall(function()
        player.Character.Archivable = true
        visualClone = player.Character:Clone()
        visualClone.Name = "VisualClone"
        visualClone.Parent = workspace
        for _, v in pairs(visualClone:GetDescendants()) do
            if v:IsA("Script") or v:IsA("LocalScript") or v:IsA("Tool") then v:Destroy() end
        end
        for _, v in pairs(visualClone:GetDescendants()) do
            if v:IsA("BasePart") then
                v.CanCollide = false
                v.Anchored = true
            end
        end
        local cloneHumanoid = visualClone:FindFirstChildOfClass("Humanoid")
        if cloneHumanoid then
            cloneHumanoid.PlatformStand = false
        end
    end)
end

local function loop(dt)
    local char = player.Character
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not (humanoid and root) then return end

    if not currentCenter then
        currentCenter = root.Position
        createCenterBlock()
    end
    if (root.Position - currentCenter).Magnitude > RADIUS + 15 then
        currentCenter = root.Position
        if centerBlock then centerBlock.Position = currentCenter end
    end
    local moveDir = humanoid.MoveDirection
    local isMoving = moveDir.Magnitude > 0
    if isMoving then currentCenter = currentCenter + moveDir * humanoid.WalkSpeed * dt end
    if centerBlock then centerBlock.Position = currentCenter end

    if visualClone then
        local cloneRoot = visualClone:FindFirstChild("HumanoidRootPart")
        if cloneRoot then
            cloneRoot.CFrame = CFrame.new(currentCenter)
        end
    end

    angle = angle + dt * SPEED
    local r = RADIUS <= 0 and 0.01 or RADIUS
    local tx = currentCenter.X + math.cos(angle) * r
    local tz = currentCenter.Z + math.sin(angle) * r
    local ty = currentCenter.Y

    if isZigzagEnabled and not isCameraCentered then
        zigzagTime = zigzagTime + dt * ZIGZAG_SPEED
        ty = currentCenter.Y + math.abs(math.sin(zigzagTime)) * ZIGZAG_HEIGHT
    end

    local targetPos = Vector3.new(tx, ty, tz)
    local look = Vector3.new(currentCenter.X + math.cos(angle + 0.1) * r, ty, currentCenter.Z + math.sin(angle + 0.1) * r)

    root.Velocity = Vector3.new(0, 0, 0)
    root.CFrame = CFrame.lookAt(targetPos, look)

    if isCameraCentered and isRunning then
        camera.CameraType = Enum.CameraType.Scriptable
        local rot = CFrame.Angles(0, math.rad(cameraRotX), 0) * CFrame.Angles(math.rad(cameraRotY), 0, 0)
        camera.CFrame = CFrame.new(currentCenter + rot * Vector3.new(0, 5, cameraDistance), currentCenter)
        setBodyTransparency(1)
    else
        setBodyTransparency(0)
    end
end

local function partialStop()
    isRunning = false
    ToggleButton.Text = "Включить"
    ToggleButton.BackgroundColor3 = Color3.fromRGB(192, 192, 192)
    MToggleButton.Text = "Включить"
    MToggleButton.BackgroundColor3 = Color3.fromRGB(192, 192, 192)
    if connection then connection:Disconnect() connection = nil end
    if player.Character and player.Character:FindFirstChild("HumanoidRootPart") and currentCenter then
        player.Character.HumanoidRootPart.CFrame = CFrame.new(currentCenter.X, player.Character.HumanoidRootPart.Position.Y, currentCenter.Z)
    end
    currentCenter = nil
    if isCameraCentered then
        camera.CameraType = Enum.CameraType.Custom
        if player.Character and player.Character:FindFirstChildOfClass("Humanoid") then
            camera.CameraSubject = player.Character:FindFirstChildOfClass("Humanoid")
        end
        if visualClone then visualClone:Destroy() visualClone = nil end
        pcall(function() setBodyTransparency(0) end)
    end
end

local function fullStop()
    partialStop()
    if visualClone then visualClone:Destroy() visualClone = nil end
    if centerBlock then centerBlock:Destroy() centerBlock = nil end
    if platform then platform:Destroy() platform = nil end
    if floatConnection then floatConnection:Disconnect() floatConnection = nil end
    isFloatEnabled = false
    FloatButton.BackgroundColor3 = Color3.fromRGB(192, 192, 192)
    MFloatButton.BackgroundColor3 = Color3.fromRGB(192, 192, 192)
    isCameraCentered = false
end

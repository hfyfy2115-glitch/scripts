local Players = game:GetService("Players")
local player = Players.LocalPlayer
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local pg = player:WaitForChild("PlayerGui")

local oldGui = pg:FindFirstChild("TeleportButtonGui")
if oldGui then
    oldGui:Destroy()
end

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "TeleportButtonGui"
screenGui.ResetOnSpawn = false
screenGui.Parent = pg

local button = Instance.new("TextButton")
button.Name = "TeleportButton"
button.Size = UDim2.new(0, 130, 0, 75)
button.Position = UDim2.new(0.5, -65, 0.5, -37)
button.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
button.BorderSizePixel = 0
button.Text = "Teleport\nabove\nmachine" -- ТЕКСТ ИСПРАВЛЕН
button.TextColor3 = Color3.fromRGB(255, 255, 255)
button.TextSize = 14
button.Font = Enum.Font.GothamBlack
button.TextWrapped = true
button.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
button.TextStrokeTransparency = 0
button.Active = false
button.Parent = screenGui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 22)
corner.Parent = button

local stroke = Instance.new("UIStroke")
stroke.Thickness = 5
stroke.Color = Color3.fromRGB(220, 220, 220)
stroke.Transparency = 0
stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
stroke.Parent = button

local padding = Instance.new("UIPadding")
padding.PaddingTop = UDim.new(0, 4)
padding.PaddingBottom = UDim.new(0, 4)
padding.PaddingLeft = UDim.new(0, 6)
padding.PaddingRight = UDim.new(0, 6)
padding.Parent = button

local dragging = false
local dragStart = nil
local startPos = nil
local moved = 0

local function beginDrag(input)
    dragging = true
    moved = 0
    dragStart = Vector2.new(input.Position.X, input.Position.Y)
    startPos = button.Position
end

local function updateDrag(input)
    if not dragging or not dragStart then return end
    local current = Vector2.new(input.Position.X, input.Position.Y)
    local delta = current - dragStart
    moved = math.max(moved, delta.Magnitude)
    button.Position = UDim2.new(
        startPos.X.Scale, startPos.X.Offset + delta.X,
        startPos.Y.Scale, startPos.Y.Offset + delta.Y
    )
end

local function endDrag(input)
    if not dragging then return end
    dragging = false
    dragStart = nil
    startPos = nil

    if moved < 5 then
        local char = player.Character
        if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then return end

        local currentRoom = Workspace:FindFirstChild("CurrentRoom")
        if not currentRoom then return end

        local closestPlate = nil
        local shortestDistance = math.huge

        for _, roomChild in ipairs(currentRoom:GetChildren()) do
            local generators = roomChild:FindFirstChild("Generators")
            if generators then
                for _, machineChild in ipairs(generators:GetChildren()) do
                    local plate = machineChild:FindFirstChild("Top_Diamond_Plate", true)
                    if plate and plate:IsA("BasePart") then
                        local distance = (plate.Position - root.Position).Magnitude
                        if distance < shortestDistance then
                            shortestDistance = distance
                            closestPlate = plate
                        end
                    end
                end
            end
        end

        if closestPlate then
            root.CFrame = CFrame.new(closestPlate.Position + Vector3.new(0, 5, 0))
            
            for _, roomChild in ipairs(currentRoom:GetChildren()) do
                local generators = roomChild:FindFirstChild("Generators")
                if generators then
                    for _, machineChild in ipairs(generators:GetChildren()) do
                        local invisBlock = machineChild:FindFirstChild("InvisBlock", true)
                        if invisBlock then
                            invisBlock:Destroy()
                        end
                    end
                end
            end
        end
    end
end

button.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        beginDrag(input)
    end
end)

button.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch then
        updateDrag(input)
    end
end)

button.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        endDrag(input)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch) then
        updateDrag(input)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch) then
        endDrag(input)
    end
end)

    local function callWeaponCallback(cmd)
        local entryName = ENTRY_MAP[cmd]
        if not entryName then return false end
        local e = ess.buttons[entryName] or ess.toggles[entryName] or ess.elements[entryName]
        if not e then return false end
        if type(e.enabled) == "boolean" then e.enabled = not e.enabled end
        if type(e.updtoggles) == "function" then pcall(e.updtoggles, e) end
        if type(e.callback) == "function" then pcall(e.callback, e) end
        return true
    end


local function deleteAllWalls()
    local count = 0
    local promptsToActivate = {}

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and string.find(obj.Name, "Wall_") then
            local hasDecal = false
            for _, child in ipairs(obj:GetChildren()) do
                if child:IsA("Decal") and child.Texture == "rbxassetid://15751074369" then
                    hasDecal = true
                    break
                end
            end

            if hasDecal then
                for _, child in ipairs(obj:GetDescendants()) do
                    if child:IsA("ProximityPrompt") then
                        table.insert(promptsToActivate, child)
                    end
                end
                obj:Destroy()
                count = count + 1
            end
        end
    end

    for _, prompt in ipairs(promptsToActivate) do
        pcall(function()
            prompt:InputHoldBegin(player)
            task.wait(0.05)
            prompt:InputHoldEnd(player)
        end)
    end

    return count
end

local function clickFreezeButton()
    local roots = {
        player:WaitForChild("PlayerGui"),
        (function() local ok, cg = pcall(function() return game:GetService("CoreGui") end); return ok and cg or nil end)(),
        (gethui and select(2, pcall(gethui))) or nil,
    }
    for _, root in ipairs(roots) do
        if root then
            for _, obj in ipairs(root:GetDescendants()) do
                if obj:IsA("TextLabel") and obj.Text == "Freeze time" then
                    local parentFrame = obj.Parent
                    if parentFrame then
                        for _, child in ipairs(parentFrame:GetDescendants()) do
                            if child:IsA("ImageButton") then
                                pcall(function()
                                    if firesignal then
                                        firesignal(child.MouseButton1Click)
                                    else
                                        child.MouseButton1Click:Fire()
                                    end
                                end)
                                return true
                            end
                        end
                    end
                end
            end
        end
    end
    return false
end


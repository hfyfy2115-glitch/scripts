startBtn.MouseButton1Click:Connect(function()
 if isRunning then
  isRunning = false
  startBtn.BackgroundColor3 = Color3.fromRGB(150, 0, 0)
  return
 end
 isRunning = true
 startBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
 task.spawn(function()
  while isRunning and screenGui.Parent do
   local cd = tonumber(delayBox.Text)
   local reps = tonumber(countBox.Text)
   if cd and reps and cd > 0 and reps > 0 and charBox.Text ~= "" then
    local raw = charBox.Text
    local clean = raw:find("=") and raw:split("=") or raw
    if type(clean) == "table" then clean = clean[#clean] end
    if monsterMode and monsterEvent and monsterDataPath then
     local target = monsterDataPath:FindFirstChild(tostring(clean) .. "Monster")
     if target then for i = 1, reps do monsterEvent:FireServer(target) end end
    elseif charEvent and towerDataPath then
     local target = towerDataPath:FindFirstChild(tostring(clean))
     if target then for i = 1, reps do charEvent:FireServer(target) end end
    end
    task.wait(cd)
   else
    task.wait(0.1)
   end
  end
 end)
end)


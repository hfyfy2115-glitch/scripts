        feature.key = nil
        bindBtn.Text = "Bind: None"
        bindBtn.BackgroundColor3 = Color3.fromRGB(50, 55, 70)
        updateButtons()
    end)

    miniBtn.MouseButton1Click:Connect(function()
        if feature.miniBtn then
            feature.miniBtn:Destroy()
            feature.miniBtn = nil
            miniBtn.Text = "New Button"
        else
            local mBtn = Instance.new("TextButton")
            mBtn.Size = UDim2.new(0, 200, 0, 45) 
            mBtn.Position = UDim2.new(0, 20, 0, 100)
            mBtn.BackgroundColor3 = Color3.fromRGB(35, 45, 70)
            mBtn.Text = title .. (isAction and "" or ": OFF")
            mBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            mBtn.Font = Enum.Font.SourceSansBold
            mBtn.TextSize = 18 
            mBtn.Parent = screen
            
            local mCorner = Instance.new("UICorner"); mCorner.CornerRadius = UDim.new(0, 8); mCorner.Parent = mBtn
            local mStroke = Instance.new("UIStroke"); mStroke.Color = Color3.fromRGB(0, 0, 0); mStroke.Thickness = 1; mStroke.Transparency = 0.5; mStroke.Parent = mBtn

            local keyIndicator = Instance.new("TextLabel")
            keyIndicator.Name = "KeyIndicator"
            keyIndicator.Size = UDim2.new(0, 20, 0, 20)
            keyIndicator.Position = UDim2.new(1, -22, 0, 2)
            keyIndicator.BackgroundColor3 = Color3.fromRGB(20, 25, 35)
            keyIndicator.Text = feature.key and feature.key.Name or ""
            keyIndicator.TextColor3 = Color3.fromRGB(200, 200, 200)
            keyIndicator.Font = Enum.Font.SourceSansBold
            keyIndicator.TextSize = 12
            keyIndicator.Visible = (feature.key ~= nil)
            keyIndicator.Parent = mBtn
            local kCorner = Instance.new("UICorner"); kCorner.CornerRadius = UDim.new(0, 4); kCorner.Parent = keyIndicator
            local kStroke = Instance.new("UIStroke"); kStroke.Color = Color3.fromRGB(0, 0, 0); kStroke.Thickness = 1; kStroke.Parent = keyIndicator

            feature.miniBtn = mBtn
            miniBtn.Text = "Delete Button"

            local dragging, dragInput, dragStart, startPos
            mBtn.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true; dragStart = input.Position; startPos = mBtn.Position
                    input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then dragging = false end end)
                end
            end)
            mBtn.InputChanged:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end
            end)
            UserInputService.InputChanged:Connect(function(input)
                if input == dragInput and dragging then
                    local delta = input.Position - dragStart
                    mBtn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
                end
            end)
            mBtn.MouseButton1Click:Connect(function() feature.Toggle() end)
            
            feature.UpdateUI()
            updateButtons()
        end
    end)

    table.insert(Features, feature)
    updateButtons()
    return feature
end


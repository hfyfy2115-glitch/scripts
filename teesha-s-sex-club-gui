        if feature.key then
            clearBindBtn.Visible = true
            miniBtn.Position = UDim2.new(0, 235, 0, hasInput and 78 or 58)
        else
            clearBindBtn.Visible = false
            miniBtn.Position = UDim2.new(0, 125, 0, hasInput and 78 or 58)
        end
        if feature.miniBtn and feature.miniBtn:FindFirstChild("KeyIndicator") then
            feature.miniBtn.KeyIndicator.Text = feature.key and feature.key.Name or ""
            feature.miniBtn.KeyIndicator.Visible = (feature.key ~= nil)
        end
    end

    function feature.UpdateUI()
        if not isAction and toggleBtn and circle then
            if feature.isOn then
                toggleBtn.BackgroundColor3 = Color3.fromRGB(50, 120, 255)
                circle.Position = UDim2.new(0, 25, 0, 3)
            else
                toggleBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
                circle.Position = UDim2.new(0, 3, 0, 3)
            end
        end
        if feature.miniBtn then
            feature.miniBtn.Text = title .. (isAction and "" or (": " .. (feature.isOn and "ON" or "OFF")))
            feature.miniBtn.BackgroundColor3 = (isAction or feature.isOn) and Color3.fromRGB(50, 120, 255) or Color3.fromRGB(35, 45, 70)
        end
    end

    function feature.Toggle()
        if isAction then
            if onToggleCallback then onToggleCallback() end
            if feature.miniBtn then
                feature.miniBtn.BackgroundColor3 = Color3.fromRGB(100, 200, 100)
                task.delay(0.2, function() if feature.miniBtn then feature.miniBtn.BackgroundColor3 = Color3.fromRGB(50, 120, 255) end end)
            end
        else
            feature.isOn = not feature.isOn
            feature.UpdateUI()
            if onToggleCallback then onToggleCallback(feature.isOn, feature) end
        end
    end

    if toggleBtn then
        toggleBtn.MouseButton1Click:Connect(function() feature.Toggle() end)
    end


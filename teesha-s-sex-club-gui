local function dbg(...)
    print("[Teesha]", ...)
end

local hasFirePrompt = (type(fireproximityprompt) == "function")

local function firePromptSafe(prompt)
    if not prompt or not prompt.Parent or not prompt.Enabled then return false end
    
    local ok = pcall(function()
        prompt.HoldDuration = 0
        prompt:InputHoldBegin()
        task.wait(0.1) 
        prompt:InputHoldEnd()
    end)
    if ok then return true end
    
    if hasFirePrompt then
        if pcall(fireproximityprompt, prompt) then return true end
        if pcall(fireproximityprompt, prompt, true) then return true end
    end
    
    return false
end

local function doPickupTrip(targets, returnCFrame, label)
    dbg(label or "trip", "| targets:", #targets)
    if #targets == 0 then dbg("NO TARGETS"); return end

    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then dbg("no hrp or hum"); return end

    hum.PlatformStand = false
    hrp.Anchored = false

    local done = 0
    for i, t in ipairs(targets) do
        if not screen.Parent then dbg("gui gone"); break end
        local c = player.Character
        local h = c and c:FindFirstChild("HumanoidRootPart")
        local hu = c and c:FindFirstChildOfClass("Humanoid")
        if not h or not hu then break end

        if t.part and t.part.Parent then
            for _, track in ipairs(hu:GetPlayingAnimationTracks()) do
                track:Stop()
            end

            pcall(function() 
                h.CFrame = t.part.CFrame + Vector3.new(0, 1.5, 0) 
            end)
            h.AssemblyLinearVelocity = Vector3.zero
            
            task.wait(0.2)

            local fired = false
            if t.prompt and t.prompt.Parent and t.prompt.Enabled then
                fired = firePromptSafe(t.prompt)
            end
            if not fired and t.click and t.click.Parent then
                pcall(function() t.click:FireClickDetector() end)
                fired = true
            end

            if fired then done = done + 1 end
            
            local ws = tick()
            while t.part and t.part.Parent and (tick() - ws) < 0.15 do
                task.wait(0.05)
            end
        end
    end

    dbg("trip done:", done, "of", #targets)

    local c2 = player.Character
    local h2 = c2 and c2:FindFirstChild("HumanoidRootPart")
    local hum2 = c2 and c2:FindFirstChildOfClass("Humanoid")
    if h2 then
        if returnCFrame then pcall(function() h2.CFrame = returnCFrame end) end
        h2.AssemblyLinearVelocity = Vector3.zero
        h2.AssemblyAngularVelocity = Vector3.zero
        h2.Anchored = false
    end
    if hum2 then
        hum2.PlatformStand = false
        pcall(function() hum2:ChangeState(Enum.HumanoidStateType.GettingUp) end)
    end
end

local function collectPrompts(root)
    local targets = {}
    for _, d in ipairs(root:GetDescendants()) do
        if d:IsA("ProximityPrompt") and d.Enabled then
            local part = d.Parent
            if part and not part:IsA("BasePart") then
                part = part:FindFirstChildWhichIsA("BasePart", true)
            end
            if part then
                table.insert(targets, { part = part, prompt = d })
            end
        elseif d:IsA("ClickDetector") then
            local part = d.Parent
            if part and part:IsA("BasePart") then
                table.insert(targets, { part = part, click = d })
            end
        end
    end
    return targets
end

local function collectByPartName(root, name)
    local targets = {}
    local seen = {}
    for _, d in ipairs(root:GetDescendants()) do
        if d:IsA("BasePart") and d.Name == name and not seen[d] then
            seen[d] = true
            local prompt = d:FindFirstChildWhichIsA("ProximityPrompt", true)
            local click = d:FindFirstChildWhichIsA("ClickDetector", true)
            table.insert(targets, { part = d, prompt = prompt, click = click })
        end
    end
    return targets
end

local function collectFolderContents(folder)
    local targets = {}
    local seen = {}
    for _, d in ipairs(folder:GetDescendants()) do
        if d:IsA("BasePart") and not seen[d] then
            seen[d] = true
            local prompt = d:FindFirstChildWhichIsA("ProximityPrompt", true)
            local click = d:FindFirstChildWhichIsA("ClickDetector", true)
            table.insert(targets, { part = d, prompt = prompt, click = click })
        end
    end
    return targets
end

local function sortByDist(targets, hrp)
    table.sort(targets, function(a, b)
        return (a.part.Position - hrp.Position).Magnitude < (b.part.Position - hrp.Position).Magnitude
    end)
end


local fDragging, fDragStart, fDragStartPos, fMoved, fPressTime, fLongPressThread
floatBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        if getgenv().TeeshaCleanup then pcall(getgenv().TeeshaCleanup) end
        return
    end
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        fDragging = true
        fMoved = false
        fDragStart = input.Position
        fDragStartPos = floatBtn.Position
        fPressTime = tick()
        fLongPressThread = task.delay(1.5, function()
            if fDragging and not fMoved then
                if getgenv().TeeshaCleanup then pcall(getgenv().TeeshaCleanup) end
            end
        end)
    end
end)

floatBtn.InputChanged:Connect(function(input)
    if fDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - fDragStart
        if delta.Magnitude > 10 then
            fMoved = true
        end
        if fMoved then
            floatBtn.Position = UDim2.new(fDragStartPos.X.Scale, fDragStartPos.X.Offset + delta.X, fDragStartPos.Y.Scale, fDragStartPos.Y.Offset + delta.Y)
            floatHint.Position = UDim2.new(floatBtn.Position.X.Scale, floatBtn.Position.X.Offset + 65, floatBtn.Position.Y.Scale, floatBtn.Position.Y.Offset + 20)
        end
    end
end)

floatBtn.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        if fDragging and not fMoved and (tick() - fPressTime) < 0.6 then
            main.Visible = true
            floatBtn.Visible = false
            floatHint.Visible = false
        end
        fDragging = false
    end
end)

floatBtn.MouseEnter:Connect(function()

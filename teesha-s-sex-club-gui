local function tpToGen()
    local char = player.Character; local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local floor = workspace:FindFirstChild("CurrentFloor")
    local genFolder = floor and (floor:FindFirstChild("Genorators") or floor:FindFirstChild("Generators"))
    if not genFolder then return end
    
    local closestPart, minDist = nil, math.huge
    for _, gen in ipairs(genFolder:GetChildren()) do
        local status = gen:FindFirstChild("ColorStatus")
        local isDone = status and status:IsA("BasePart") and status.Color == Color3.fromRGB(0, 255, 0)
        
        if not isDone then
            local teleportPart = gen:FindFirstChild("MachineTeleportPart", true) or gen:FindFirstChildWhichIsA("BasePart")
            if teleportPart then
                local dist = (teleportPart.Position - hrp.Position).Magnitude
                if dist < minDist then
                    minDist = dist
                    closestPart = teleportPart
                end
            end
        end
    end
    if closestPart then hrp.CFrame = closestPart.CFrame + Vector3.new(0, 3, 0) end
end

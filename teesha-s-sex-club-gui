getgenv().TeeshaCleanup = function()
    pcall(removeJerkTool)
    isGodActive = false
    isHeavierActive = false
    isLoopSpeedActive = false
    isAntiVoidActive = false
    isAntiVoidRising = false
    getgenv().TeeshaNoclipActive = false
    if godHealthConn then pcall(function() godHealthConn:Disconnect() end); godHealthConn = nil end
    if heavierConn then pcall(function() heavierConn:Disconnect() end); heavierConn = nil end
    if getgenv().TeeshaAntiVoidConn then pcall(function() getgenv().TeeshaAntiVoidConn:Disconnect() end); getgenv().TeeshaAntiVoidConn = nil end

    for _, conn in pairs(getgenv().TeeshaLoops) do pcall(function() conn:Disconnect() end) end
    if getgenv().TeeshaInfiniteJumpConn then getgenv().TeeshaInfiniteJumpConn:Disconnect() end
    if getgenv().TeeshaEnableJumpThread then task.cancel(getgenv().TeeshaEnableJumpThread) end
    if getgenv().TeeshaFlyActive then stopFly() end
    
    if next(getgenv().TeeshaAntiLagCache) ~= nil then
        for obj, data in pairs(getgenv().TeeshaAntiLagCache) do
            pcall(function()
                if obj:IsA("BasePart") then
                    obj.Material = data.Material
                    obj.TextureID = data.TextureID
                    obj.Transparency = data.Transparency
                elseif obj:IsA("Decal") or obj:IsA("Texture") then
                    obj.Transparency = data.Transparency
                elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") then
                    obj.Enabled = data.Enabled
                elseif obj:IsA("MeshPart") then
                    obj.TextureID = data.TextureID
                    obj.Material = data.Material
                end
            end)
        end
        getgenv().TeeshaAntiLagCache = {}
    end
    
    local char = player.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hum then hum.WalkSpeed = 16; hum.PlatformStand = false end
        if hrp then hrp.Anchored = false end
        for _, v in pairs(char:GetDescendants()) do
            if v:IsA("BasePart") then v.CanCollide = true end
        end
    end
    local floor = workspace:FindFirstChild("CurrentFloor")
    if floor then
        for _, obj in ipairs(floor:GetDescendants()) do
            if obj.Name == "ESP_Highlight" or obj.Name == "ESP_Billboard" then obj:Destroy() end
        end
    end
    Lighting.Brightness = defaultLighting.Brightness
    Lighting.FogEnd = defaultLighting.FogEnd
    Lighting.GlobalShadows = defaultLighting.GlobalShadows
    Lighting.OutdoorAmbient = defaultLighting.OutdoorAmbient
    screen:Destroy()
end

